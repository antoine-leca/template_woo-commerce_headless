    "fields": [
        {
            "key": "field_pg47_info",
            "label": "Contenu de la FAQ",
            "name": "",
            "type": "message",
            "new_lines": "wpautop",
            "esc_html": 0,
            "message": "<p><strong>Toute la FAQ se modifie ici.</strong> Chaque rubrique (ex. « Livraison ») s’affiche comme un panneau repliable. Dans chaque rubrique, saisissez les questions (sous-titres) et leurs réponses (paragraphes).</p><p>Pour ajouter une rubrique ou une question, remplissez un emplacement vide ; pour en retirer une, videz son titre / sa question et sa réponse.</p>"
        },
